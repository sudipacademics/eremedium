NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
# Optional: enables the live Google territory map with PIN-code geocoding and native zoom controls.
# Enable Maps JavaScript API and Geocoding API for a browser-restricted key.
# Keep the real key only in your untracked .env.local file; never commit it or send it in chat.
# Add `http://localhost:3002/*` and your production domain under Website restrictions in Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# CGPEY Aadhaar OTP for Agreement Accept / eSign (RFMS local-api only — never expose to the browser).
# Set real values in the host/docker env; leave blank locally and use RFMS_CGPEY_SIMULATE=1.
RFMS_CGPEY_API_KEY=
RFMS_CGPEY_API_SECRET=
RFMS_CGPEY_MERCHANT_ID=
RFMS_CGPEY_BASE_URL=https://verify.cgpey.com
RFMS_CGPEY_SIMULATE=1
MYSQL_DATABASE=rfms
MYSQL_USER=rfms
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me
REDIS_HOST=redis
