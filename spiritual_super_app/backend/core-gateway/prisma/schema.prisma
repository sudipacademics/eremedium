generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum ReferenceType {
  CALL_SESSION
  PUJA_BOOKING
  AYURVEDA_ORDER
  RECHARGE
}

enum PaymentProvider {
  RAZORPAY
}

enum PaymentOrderStatus {
  CREATED
  PAID
  FAILED
}

enum AstrologerStatus {
  OFFLINE
  IDLE
  BUSY
  IN_CALL
}

enum CallSessionStatus {
  INITIATED
  ACTIVE
  COMPLETED
  DROPPED_INSUFFICIENT_FUNDS
}

enum PujaBookingStatus {
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  PRASAD_DISPATCHED
}

enum Dosha {
  VATA
  PITTA
  KAPHA
  TRIDOSHIC
}

model User {
  id                String    @id @default(uuid()) @db.Uuid
  phone             String    @unique @db.VarChar(20)
  name              String    @db.VarChar(160)
  dob               DateTime? @db.Timestamptz(3)
  birthPlace        String?   @map("birth_place") @db.VarChar(180)
  latitude          Decimal?  @db.Decimal(9, 6)
  longitude         Decimal?  @db.Decimal(9, 6)
  gotra             String?   @db.VarChar(120)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  wallet            Wallet?
  astrologer        Astrologer?
  paymentOrders     PaymentOrder[]
  callSessions      CallSession[]
  pujaBookings      PujaBooking[]
  ayurvedicProfiles AyurvedicProfile[]

  @@map("users")
}

model Wallet {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  balance   Decimal  @default(0) @db.Decimal(12, 2)
  currency  String   @default("INR") @db.Char(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id             String          @id @default(uuid()) @db.Uuid
  walletId       String          @map("wallet_id") @db.Uuid
  amount         Decimal         @db.Decimal(12, 2)
  type           TransactionType
  referenceType  ReferenceType   @map("reference_type")
  referenceId    String          @map("reference_id") @db.VarChar(120)
  balanceAfter   Decimal         @map("balance_after") @db.Decimal(12, 2)
  idempotencyKey String?         @unique @map("idempotency_key") @db.VarChar(160)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@index([referenceType, referenceId])
  @@map("wallet_transactions")
}

/**
 * A top-up intent. Money reaches a wallet only when a signed provider webhook flips a row here to
 * PAID, so this table is the audit trail linking external payments to internal ledger entries.
 */
model PaymentOrder {
  id                String             @id @default(uuid()) @db.Uuid
  userId            String             @map("user_id") @db.Uuid
  provider          PaymentProvider    @default(RAZORPAY)
  providerOrderId   String             @unique @map("provider_order_id") @db.VarChar(120)
  /** Unique: the database, not application logic, is the final guard against double-crediting a replayed webhook. */
  providerPaymentId String?            @unique @map("provider_payment_id") @db.VarChar(120)
  amount            Decimal            @db.Decimal(12, 2)
  currency          String             @default("INR") @db.Char(3)
  status            PaymentOrderStatus @default(CREATED)
  /** Set when the credit lands, giving a two-way link between payment and ledger. */
  walletTransactionId String?          @unique @map("wallet_transaction_id") @db.Uuid
  failureReason     String?            @map("failure_reason") @db.VarChar(300)
  paidAt            DateTime?          @map("paid_at") @db.Timestamptz(3)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([status])
  @@map("payment_orders")
}

model Astrologer {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @unique @map("user_id") @db.Uuid
  displayName     String           @map("display_name") @db.VarChar(160)
  perMinuteRate   Decimal          @map("per_minute_rate") @db.Decimal(12, 2)
  /** The ASTROLOGER's share of each billed minute, 0..1. The platform keeps (1 - commissionSplit). */
  commissionSplit Decimal          @default("0.50") @map("commission_split") @db.Decimal(5, 4)
  status          AstrologerStatus @default(OFFLINE)
  languages       String[]         @default([])
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  callSessions CallSession[]
  earnings     AstrologerEarning[]
  pujaReferals PujaBooking[]       @relation("PujaReferral")

  @@index([status])
  @@map("astrologers")
}

/**
 * One row per billed minute, written in the SAME transaction as the user's debit.
 *
 * Without this an astrologer earned nothing: `commissionSplit` existed but no code ever read it.
 * Splitting inside the billing transaction means platform revenue and astrologer payable can never
 * disagree with what the user was actually charged.
 */
model AstrologerEarning {
  id            String   @id @default(uuid()) @db.Uuid
  astrologerId  String   @map("astrologer_id") @db.Uuid
  callSessionId String   @map("call_session_id") @db.Uuid
  /** Which billing minute this covers; pairs with callSessionId for replay safety. */
  minuteNumber  Int      @map("minute_number")
  /** What the user was charged for this minute. */
  grossAmount   Decimal  @map("gross_amount") @db.Decimal(12, 2)
  /** Astrologer's share, gross * commissionSplit at the time of the call. */
  netAmount     Decimal  @map("net_amount") @db.Decimal(12, 2)
  /** Platform's share, always gross - net. */
  platformFee   Decimal  @map("platform_fee") @db.Decimal(12, 2)
  /** Snapshot of the rate applied, so later rate changes cannot rewrite history. */
  commissionSplit Decimal @map("commission_split") @db.Decimal(5, 4)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  astrologer  Astrologer  @relation(fields: [astrologerId], references: [id], onDelete: Restrict)
  callSession CallSession @relation(fields: [callSessionId], references: [id], onDelete: Restrict)

  @@unique([callSessionId, minuteNumber])
  @@index([astrologerId, createdAt])
  @@map("astrologer_earnings")
}

model CallSession {
  id             String            @id @default(uuid()) @db.Uuid
  userId         String            @map("user_id") @db.Uuid
  astrologerId   String            @map("astrologer_id") @db.Uuid
  channelId      String            @unique @map("channel_id") @db.VarChar(120)
  ratePerMinute  Decimal           @map("rate_per_minute") @db.Decimal(12, 2)
  startTime      DateTime?         @map("start_time") @db.Timestamptz(3)
  endTime        DateTime?         @map("end_time") @db.Timestamptz(3)
  totalMinutes   Int               @default(0) @map("total_minutes")
  totalDeducted  Decimal           @default(0) @map("total_deducted") @db.Decimal(12, 2)
  status         CallSessionStatus @default(INITIATED)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  user       User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  astrologer Astrologer          @relation(fields: [astrologerId], references: [id], onDelete: Restrict)
  earnings   AstrologerEarning[]

  @@index([userId, createdAt])
  @@index([astrologerId, createdAt])
  @@index([status])
  @@map("call_sessions")
}

model Temple {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @db.VarChar(180)
  location       String   @db.VarChar(180)
  primaryDeity   String   @map("primary_deity") @db.VarChar(120)
  liveStreamUrl  String?  @map("live_stream_url") @db.VarChar(500)
  /** Hides a temple from the catalog without deleting it, which bookings would forbid anyway. */
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  pujaBookings PujaBooking[]
  offerings    PujaOffering[]

  @@unique([name, location])
  @@index([active])
  @@map("temples")
}

/**
 * The priced catalog of pujas a temple performs.
 *
 * This table exists because price was previously whatever the caller put in the request body: the
 * astrologer's in-call remedy card carried its own `packagePrice`, so the amount a devotee was
 * charged was decided by the client rather than by the platform. Every booking now takes its price
 * from here, and the offering is recorded on the booking so a later price change cannot rewrite what
 * somebody already paid.
 */
model PujaOffering {
  id            String   @id @default(uuid()) @db.Uuid
  templeId      String   @map("temple_id") @db.Uuid
  name          String   @db.VarChar(160)
  description   String?  @db.VarChar(1000)
  /** What the devotee pays. The single source of truth for the price of this puja. */
  price         Decimal  @db.Decimal(12, 2)
  /** Indicative duration shown in the catalog, e.g. "45 minutes". */
  durationLabel String?  @map("duration_label") @db.VarChar(60)
  /** What arrives by post afterwards, e.g. "Prasad, rudraksha and photographs". */
  prasadIncluded String? @map("prasad_included") @db.VarChar(300)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  temple   Temple        @relation(fields: [templeId], references: [id], onDelete: Cascade)
  bookings PujaBooking[]

  @@unique([templeId, name])
  @@index([templeId, active])
  @@map("puja_offerings")
}

model PujaBooking {
  id                     String            @id @default(uuid()) @db.Uuid
  userId                 String            @map("user_id") @db.Uuid
  templeId               String            @map("temple_id") @db.Uuid
  /** Nullable only for bookings made before the catalog existed. */
  pujaOfferingId         String?           @map("puja_offering_id") @db.Uuid
  /** Snapshot of the offering name, so renaming a puja cannot rewrite an existing booking. */
  pujaName               String            @map("puja_name") @db.VarChar(160)
  referredByAstrologerId String?           @map("referred_by_astrologer_id") @db.Uuid
  sankalpName            String            @map("sankalp_name") @db.VarChar(160)
  sankalpGotra           String?           @map("sankalp_gotra") @db.VarChar(120)
  sankalpWish            String?           @map("sankalp_wish") @db.VarChar(1000)
  packagePrice           Decimal           @map("package_price") @db.Decimal(12, 2)
  status                 PujaBookingStatus @default(CONFIRMED)
  /** Set when the temple performs the puja. */
  scheduledFor           DateTime?         @map("scheduled_for") @db.Timestamptz(3)
  performedAt            DateTime?         @map("performed_at") @db.Timestamptz(3)
  videoProofUrl          String?           @map("video_proof_url") @db.VarChar(500)
  prasadAwb              String?           @map("prasad_awb") @db.VarChar(80)
  prasadCourier          String?           @map("prasad_courier") @db.VarChar(80)
  prasadDispatchedAt     DateTime?         @map("prasad_dispatched_at") @db.Timestamptz(3)
  /**
   * Makes a retried booking request return the original booking instead of creating a second one.
   * A double-tapped confirm button would otherwise buy the same puja twice.
   */
  idempotencyKey         String?           @unique @map("idempotency_key") @db.VarChar(160)
  createdAt              DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  user                 User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  temple               Temple        @relation(fields: [templeId], references: [id], onDelete: Restrict)
  offering             PujaOffering? @relation(fields: [pujaOfferingId], references: [id], onDelete: Restrict)
  referredByAstrologer Astrologer?   @relation("PujaReferral", fields: [referredByAstrologerId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([templeId, status])
  @@index([status, createdAt])
  @@map("puja_bookings")
}

model AyurvedicProfile {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  prakritiPrimary Dosha    @map("prakriti_primary")
  vikritiCurrent  Dosha?   @map("vikriti_current")
  dominantGuna    String?  @map("dominant_guna") @db.VarChar(40)
  digestiveFire   String?  @map("digestive_fire") @db.VarChar(40)
  vataScore       Decimal  @default(0) @map("vata_score") @db.Decimal(5, 2)
  pittaScore      Decimal  @default(0) @map("pitta_score") @db.Decimal(5, 2)
  kaphaScore      Decimal  @default(0) @map("kapha_score") @db.Decimal(5, 2)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("ayurvedic_profiles")
}
