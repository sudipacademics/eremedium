# Copy to .env and fill in. Never commit .env.
PUBLIC_DOMAIN=localhost
LOG_LEVEL=info

# PostgreSQL
POSTGRES_USER=ssa_admin
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=ssa_core

# Redis
REDIS_PASSWORD=change-me-redis

# Astro service: path to the Swiss Ephemeris .se1 files inside the container
EPHE_PATH=/app/ephemeris

# Auth / internal service-to-service
JWT_SECRET=change-me-32-byte-min-secret-value
INTERNAL_SERVICE_TOKEN=change-me-internal-token-min-32-chars

# LiveKit
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change-me-livekit-secret-32-bytes
# Host ROOT with no /rtc suffix. The LiveKit client appends /rtc/v1 to this base itself, so a
# ".../rtc" value produces "/rtc/rtc/v1" and every call fails to connect.
LIVEKIT_PUBLIC_URL=wss://localhost

# Coturn
TURN_REALM=turn.localhost
TURN_SHARED_SECRET=change-me-turn-secret

# Node gateway (used when running outside docker)
DATABASE_URL=postgresql://ssa_admin:change-me-postgres@localhost:5432/ssa_core?schema=public
REDIS_URL=redis://:change-me-redis@localhost:6379/0
ASTRO_SERVICE_URL=http://localhost:8001
LIVEKIT_URL=ws://localhost:7880
BILLING_TICK_SECONDS=60
MIN_CALL_MINUTES_BUFFER=5

# --- Phone OTP login -------------------------------------------------------------------------
# SMS_PROVIDER=log only delivers nowhere; use msg91 for real SMS.
SMS_PROVIDER=log
# Returns the OTP in the API response so staging can be tested without an SMS vendor.
# The gateway REFUSES TO START if this is true while NODE_ENV=production.
OTP_DEBUG_ECHO=false
# Explicit opt-in for log SMS and OTP_TEST_NUMBERS under NODE_ENV=production (demo hosts).
# Leave false when MSG91 is configured and OTP_TEST_NUMBERS is empty.
ALLOW_STAGING_AUTH=false
OTP_TTL_SECONDS=300
OTP_REQUEST_MAX_PER_WINDOW=3
# Defaults to JWT_SECRET when unset; set it to rotate OTP hashing independently.
# OTP_PEPPER=
# Required only when SMS_PROVIDER=msg91 (DLT-registered template with an ##OTP## variable).
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# MSG91_SENDER=

# Browser origins for credentialed CORS (comma-separated). Empty → https://PUBLIC_DOMAIN only.
# CORS_ORIGINS=https://vedsutra.in,https://www.vedsutra.in

# "phone:code" pairs, comma separated, that receive a FIXED OTP instead of a real SMS, so the app
# can be demonstrated without an SMS vendor. Requires ALLOW_STAGING_AUTH=true in production.
# Example: OTP_TEST_NUMBERS=+919000000001:123456,+919000000002:123456
OTP_TEST_NUMBERS=
# Demo mode while SMS is not live: every non-admin number gets this code, no SMS is sent, and the
# login page shows it. Anyone can sign in to any non-admin account. Requires ALLOW_STAGING_AUTH=true.
OTP_SIMULATED_CODE=

# --- Wallet top-up (Razorpay) ----------------------------------------------------------------
# All three must be present or /api/v1/payments answers 503. The webhook secret is the one
# configured in the Razorpay dashboard for the payment.captured and payment.failed events, and is
# what proves a top-up actually happened -- wallets are credited by nothing else.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
TOPUP_MIN_AMOUNT=10.00
TOPUP_MAX_AMOUNT=100000.00

# --- Jyotish AI predictions ------------------------------------------------------------------
# AI_PROVIDER=auto|openai|gemini|groq|trial  (auto falls back to local trial with no key)
# AI_PROVIDER=auto
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# AI_PREDICT_MAX_TOKENS=1200

# --- Festival calendar (Kalia Panjika, https://developers.kaliapanjika.com/) --------------------
# Server-side only; sent as an Authorization header and never exposed to the browser.
# Without the key /api/v1/festivals answers 503 "Festival calendar is not configured".
# KALIAPANJIKA_API_KEY=
# KALIAPANJIKA_API_BASE=https://api.kaliapanjika.com
# Optional regional tradition: odia, bengali, tamil, assamese, malayalam, marathi, nepali,
# gujarati, telugu, kannada, iskcon, north_purnimanta, manipuri. Unset = the engine's base list.
# KALIAPANJIKA_REGION=

# --- Web app -----------------------------------------------------------------------------------
# Browser-visible WebSocket URL. Leave empty to derive it from the page's own origin.
PUBLIC_WS_URL=wss://vedsutra.in/api/v1/ws

# --- Astrologer supply side ------------------------------------------------------------------
# Rate applied to new astrologer profiles. Applicants cannot set their own price.
ASTROLOGER_DEFAULT_RATE=20.00
# Comma-separated E.164 numbers that get the ADMIN role on OTP login. This is the ONLY way to
# become an admin -- no endpoint grants the role, so changing admins requires a deploy.
ADMIN_PHONES=

# --- Call lifecycle backstops ----------------------------------------------------------------
# An INITIATED session holds the astrologer as IN_CALL, so unjoined invites must expire or that
# astrologer stays unbookable. ACTIVE sessions whose LiveKit room is empty are also swept.
STALE_INITIATED_SESSION_SECONDS=300
STALE_ACTIVE_SESSION_SECONDS=180
STALE_SESSION_SWEEP_SECONDS=120
