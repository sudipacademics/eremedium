{
  "name": "remedium-care-portal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "node --no-warnings server/server.mjs",
    "api:dev": "node --no-warnings --env-file-if-exists=.env.local server/server.mjs",
    "build": "tsc && vite build",
    "build:aesthetic": "tsc && vite build --mode aesthetic",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
